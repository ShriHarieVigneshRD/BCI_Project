# EEGNet Architecture Playground - backend settings (all optional).
# Copy to .env or export in your shell; the defaults below are used when unset.

# Where datasets, checkpoints, caches, exports and the SQLite registry are stored.
EEGNET_DATA_DIR=./data

# The API binds to localhost only by default. Do not expose it on a network interface.
EEGNET_HOST=127.0.0.1
EEGNET_PORT=8000

# Upper limit for a single-request dataset upload (legacy upload endpoint).
EEGNET_MAX_UPLOAD_MB=1024

# Upper limit for the files staged by one "Select dataset folder" / "Select multiple files" import.
EEGNET_MAX_IMPORT_MB=20480

# Optional: restrict "Use local folder path" to these folders (separate with ; on Windows, : elsewhere).
# Unset = any local folder that passes the safety checks (absolute, existing, not a drive root, not a
# network path, not the app's own data store). The local-path option only accepts requests from this machine.
# EEGNET_IMPORT_ROOTS=D:\eeg-studies;E:\shared\eeg

# Origins allowed to call the API during development (the Vite dev server).
EEGNET_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: keep uv's package cache on another drive (useful when the system drive is nearly full).
# UV_CACHE_DIR=E:/BCI_FInal_Project/.uv-cache
